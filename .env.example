# scripts/init-env.ps1 replaces __GENERATE__ with separate random secrets.
POSTGRES_USER=unppal
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=unppal
POSTGRES_URL=jdbc:postgresql://localhost:5432/unppal
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__
MONGO_USER=unppal
MONGO_PASSWORD=__GENERATE__
# init-env.ps1 fills the URI using MONGO_PASSWORD.
MONGODB_URI=__MONGODB_URI__
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ELASTICSEARCH_URIS=http://localhost:9200
DEV_PASSWORD=__GENERATE__

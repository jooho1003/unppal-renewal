meta {
  name: 공개 프로세스 조회
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/system
  body: none
  auth: none
}

tests {
  // 상태 코드와 실제 공개 응답 필드를 대조한다.
  test("system contract", function () {
    expect(res.status).to.equal(200);
    expect(res.body.service).to.equal(bru.getEnvVar("expectedService"));
    expect(res.body.stage).to.equal("bootstrap");
    expect(Object.keys(res.body).sort()).to.deep.equal(["service", "stage"]);
  });
}

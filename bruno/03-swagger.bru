meta {
  name: Swagger 화면 접근
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/swagger-ui/index.html
  body: none
  auth: none
}

tests {
  // 문서 화면 접근은 업무 API 인증 권한을 부여하지 않는다.
  test("Swagger UI is accessible", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.include("swagger-ui");
  });
}
